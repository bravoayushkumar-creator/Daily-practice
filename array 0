public class Main {
    public static void main(String[] args) {
        int n = 1020304;
        int result = 0;
        int place = 1;

        while (n > 0) {
            int digit = n % 10;

            if (digit != 0) {
                result = digit * place + result;
                place = place * 10;
            }

            n = n / 10;
        }

        System.out.println(result);
    }
}

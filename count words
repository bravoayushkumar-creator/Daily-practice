
public class Main {
    public static void main(String[] args) {

        String str = "Java is easy to learn";
        int count = 0;

        str = str.trim();

        if (!str.isEmpty()) {
            String[] words = str.split("\\s+");
            count = words.length;
        }

        System.out.println("Total words: " + count);
    }
}

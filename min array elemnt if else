public class Main{
    public static void main(String[]args){
        int arr[]={253,23,450,45,56,67,51};
        int count=0;
        
        for(int i=0;i<arr.length;i++){
            for(int j=i+1;j<arr.length;j++){
                if(arr[i]==arr[j]){
                    System.out.println(arr[i]);
                    count++;
                    
                }
               
                
            }
            
        }
        if(count ==0){
            System.out.println("no duplicates found");
        }
    }
}

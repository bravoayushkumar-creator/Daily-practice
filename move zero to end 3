public class Main{
    public static void main(String []args){
        int []arr={34,56,678,67,8798794,0,7,90,90,0,0,45};
        int j=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                arr[j]=arr[i];
                j++;
                
            }
        }
        while(j<arr.length){
            arr[j]=0;
            j++;
        }
        for(int i=0;i<arr.length;i++){
            System .out.print(":: "+ arr[i]);
        }
    }
}

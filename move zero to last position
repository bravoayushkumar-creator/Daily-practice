public class Main {
    public static void main(String[] args) {
        int arr[] = {23, 56, 78, 0, 56, 0, 67, 06, 0};
        int j = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != 0) {
                arr[j] = arr[i];
                j++;
            }
        }

        while (j < arr.length) {
            arr[j] = 0;
            j++;
        }

        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i]+"____");
        }
    }
}

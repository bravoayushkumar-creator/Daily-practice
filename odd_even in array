public class Main{
    public static void main(String[]args){
        int[]arr={234,767,678,689,89456,23456,46};
        int even=0;
        int odd=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]%2==0){
                System.out.println("the elemnts is even"+even);
            }
            else{
                System.out.println("the elemnts is odd"+odd);
            }
        }
        System.out.println(even);
        System.out.println(odd);
    }
}

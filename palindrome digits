public class palindrom_digits {
    public static void main(String[] args){
        int num=1221;
        int originial=num;
        int reverse=0;
        while (num!=0){
            int digits=num%10;
            reverse=reverse*10+digits;
             num=num/10;



        }
        if (originial==reverse){
            System.out.println("palindrome");
        }
        else {
            System.out.println("not palindrome");
        }

    }
}

public class Main{
    public static void main(String[]args){
        int num=122251;
        int rev=0;
        int original=num;
        while(num!=0){
            int digits=num%10;
             rev=rev*10+digits;
             num=num/10;
            
        }
        if(original==rev){
            System.out.println(" it is palindrome");
        }
        else{
            System.out.println("not palindrome");
        }
    }
}

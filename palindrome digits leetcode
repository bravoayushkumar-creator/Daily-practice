class Solution {
    public boolean isPalindrome(int x) {

        int num = x;
        int original = num;
        int rev = 0;

        while (num != 0) {
            int digits = num % 10;
            rev = rev * 10 + digits;
            num = num / 10;
        }

        if (rev == original) {
            return true;
        } else {
            return false;
        }
    }
}

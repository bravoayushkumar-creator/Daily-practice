public class Main{
    public static void main(String[]args){
        String str="madam";
        int num=121;
        int rev=0;
        int original=num;
        while(num!=0){
            
            int digits=num%10;
            rev=rev*10+digits;
            num=num/10;
            
            
        }
        if(original==rev){
            System.out.println("palindrome");
        }
        else{
            System.out.println("not palindrome");
        }
        
    }
}

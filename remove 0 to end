public class Main{
    public static void main(String[]args){
        int []arr={234,5,0,90,76,0,0,554};
        int j=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                arr[j]=arr[i];
                j++;
            }
        }
        while(j<arr.length){
            arr[j]=0;
            j++;
        }
        for(int i=0;i<arr.length;i++){
            System.out.print(" "+arr[i]);
            
        }
        //System.out.println(arr[i]);
    }
}

public class Main{
    public static void main(String []args){
        int []arr={56,0,9,0,90,0,40,4,0};
        int j=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                arr[j]=arr[i];
                j++;
                
            }
        }
        while(j<arr.length){
            arr[j]=0;
            j++;
            
        }
        for(int i=0;i<arr.length;i++){
            System.out.print(arr[i]+" ");
        }
    }
}

public class removing_zero {
    public static void main(String[] args){
        int []arr={23,34,46,0,3,0,56,0,9,1};
        int index=0;
        for (int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                arr[index]=arr[i];
                index++;
            }
        }
        while(index < arr.length){
            arr[index]=0;
            index++;
        }
        for (int i=0;i<arr.length;i++){
            System.out.println(arr[i]);
        }
    }
}

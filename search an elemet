public class Main {
    public static void main(String[] args) {

        int[] arr = {234, 4, 6, 56, 43, 456, 3};
        int target = 4;

        boolean found = false;

        for (int i = 0; i < arr.length; i++) {

            if (arr[i] == target) {
                found = true;
                break;
            }
        }

        if (found) {
            System.out.println("Element found");
        } else {
            System.out.println("Element not found");
        }
    }
}

public class Main{
    public static void main(String[]args){
        int []arr={987,56,98,90,56,1234};
        int max=arr[0];
        for(int i=1;i<arr.length;i++){
            if(arr[i]>max){
                max=arr[i];
            }
        }
        int secmax= Integer.MIN_VALUE;
        for(int i=0;i<arr.length;i++){
            if(arr[i]<secmax&&arr[i]>max){
                secmax=arr[i];
                
            }
        }
        System.out.println(secmax);
    }
}

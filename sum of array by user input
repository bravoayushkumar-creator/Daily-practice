import java.util.*;
public class Main{
    public static void main(String []args){
        Scanner sc = new Scanner(System.in);
        System.out.println("enter the elemnets :");
        int n =sc.nextInt();
        int []arr=new int [n];
        System .out.println("enter the elemnts :"+n);
        
        for(int i =0;i<n;i++){
            arr[i]=sc.nextInt();
            
        }
        int sum =0;
        for(int i=0;i<n;i++){
            sum=sum+arr[i];
        }
        System.out.println("so the sum of elemnts is : "+sum);
        
    }
}

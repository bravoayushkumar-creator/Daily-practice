public class Main{
    public static void main(String[]args){
        int []arr={34,6,78,7,7887,76543,56,7};
        int count =0;
        for(int i=0;i<arr.length-1;i++){
            for(int j=0;j<arr.length-1-i;j++){
                if(arr[j]>arr[j+1]){
                    int temp=arr[j];
                    arr[j]=arr[j+1];
                    arr[j+1]=temp;
                    count++;
                }
            }
        }
        System.out.println("count of swapping is "+count+" ");
        for(int i=0;i<arr.length;i++){
            //System.out.print("count of swapping is "+count+" ++");
            System.out.println("sorted array is "+arr[i]+"--- ");
        }
        
    }
}    
    
    

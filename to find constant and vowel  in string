public class Main{
    public static void main(String[]args){
        String a="helloworlds";
        a=a.toLowerCase();
        int constant=0;
        int vowel=0;
        for(int i=0;i<a.length();i++){
            char ch =a.charAt(i);
            if(ch>='a'&&ch<='z'){
                if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'){
                    vowel++;
                    
                }
                else
            {
                constant++;
            }
            }
            
        }
        System.out.println("constant=: "+constant);
        System.out.println(vowel+"vowel=:");
    
    }
}
